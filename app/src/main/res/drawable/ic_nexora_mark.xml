<?xml version="1.0" encoding="utf-8"?>
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="179dp"
    android:height="170dp"
    android:viewportWidth="179"
    android:viewportHeight="170">
    <!-- Nexora mark alone, cropped to its bounds (200-unit grid, x 12-191, y 10-180). Same paths as ic_launcher_foreground. -->
    <group
        android:translateX="-12"
        android:translateY="-10">
        <!-- Right stem (behind): Nexora Purple, light at the cut top, deep at the fold. -->
        <path android:pathData="M150,51 L191,10 L191,156 L150,156 Z">
            <aapt:attr name="android:fillColor">
                <gradient
                    android:type="linear"
                    android:startX="191"
                    android:startY="10"
                    android:endX="150"
                    android:endY="150">
                    <item android:offset="0" android:color="#FFC9B0FC" />
                    <item android:offset="0.45" android:color="#FF8B5CF6" />
                    <item android:offset="1" android:color="#FF4A2AD6" />
                </gradient>
            </aapt:attr>
        </path>
        <!-- Left stem (behind): dark under the fold, cyan at the cut bottom. -->
        <path android:pathData="M12,180 L54,138 L54,78 L24,50 C18,52 12,56 12,62 Z">
            <aapt:attr name="android:fillColor">
                <gradient
                    android:type="linear"
                    android:startX="33"
                    android:startY="60"
                    android:endX="33"
                    android:endY="178">
                    <item android:offset="0" android:color="#FF0A4FE0" />
                    <item android:offset="0.4" android:color="#FF0F7BF5" />
                    <item android:offset="1" android:color="#FF1FB0FF" />
                </gradient>
            </aapt:attr>
        </path>
        <!-- Ribbon band (front): rounded fold at top left, wrap at bottom right. -->
        <path android:pathData="M12,64 C12,42 28,31 50,31 C58,31 64,31.5 70,37 L191,147 L191,152 C191,163 180,171 165,171 C156,171 150,169 144,165 L24,52 C18,54 12,58 12,64 Z">
            <aapt:attr name="android:fillColor">
                <gradient
                    android:type="linear"
                    android:startX="40"
                    android:startY="35"
                    android:endX="165"
                    android:endY="170">
                    <item android:offset="0" android:color="#FF2CC8FF" />
                    <item android:offset="0.5" android:color="#FF109AFB" />
                    <item android:offset="1" android:color="#FF0A5CF0" />
                </gradient>
            </aapt:attr>
        </path>
    </group>
</vector>
