<resources>
    <style name="Theme.Nexora" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">#0B1220</item>
        <item name="android:statusBarColor">#0B1220</item>
        <item name="android:navigationBarColor">#0B1220</item>
    </style>

    <!-- System splash: brief mark on the splash backdrop, then the in-app splash takes over. -->
    <style name="Theme.Nexora.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/nexora_splash</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_launcher_foreground</item>
        <item name="postSplashScreenTheme">@style/Theme.Nexora</item>
    </style>
</resources>
